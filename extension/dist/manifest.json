{
  "manifest_version": 3,
  "name": "Spotcalendar",
  "version": "1.0.0",
  "description": "Calendrier des sorties musicales de tes artistes Spotify, directement sur Spotify Web.",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://open.spotify.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
