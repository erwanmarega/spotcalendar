{
  "version": 2,
  "builds": [
    { "src": "frontend/dist/**/*", "use": "@vercel/static" },
    { "src": "api/server.js",        "use": "@vercel/node"   }
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "api/server.js" },
    { "src": "/(.*)",     "dest": "frontend/dist/$1" }
  ]
}
