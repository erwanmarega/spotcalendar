{
    "version": 2,
    "builds": [
      {
        "src": "client/package.json",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "dist"
        }
      }
    ],
    "installCommand": "npm install && cd client && npm run build && cd .. && mkdir -p public && cp -r client/dist/* public/",
    "routes": [
      {
        "src": "/(.*)",
        "dest": "public/$1"
      }
    ]
  }