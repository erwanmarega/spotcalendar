{
  "version": 2,
  "builds": [
    {
      "src": "front-end/dist/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "back-end/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "back-end/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "front-end/dist/$1"
    }
  ],
  "buildCommand": "cd front-end && npm run build",
  "outputDirectory": "front-end/dist"
}